    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Species_distributions"/>
    <skos:definition>The probability of occurrence of European marine bird species at their breeding sites over time.</skos:definition>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/probabilityOfOccurrence"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/birds"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/marine"/>
    <skos:prefLabel>Species distributions of marine birds probability of occurrence</skos:prefLabel>
    <ns1:hasConstraint rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/indicateInTheReviewAndAnalysisOfMemberStates2018ReportsDescriptor1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/ST_phe_TER_wildFruits_POED">
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Phenology"/>
    <ns1:hasContextObject rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/fructification"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/wildFruits"/>
    <skos:definition>The annual timing of the fructification of wild fruits species within contiguous spatial units (grid cells) across the EU over time. Probability of the end date.</skos:definition>
    <ns1:hasConstraint rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/treesAndShrubs"/>
    <skos:prefLabel>Phenology of terrestrial wild fruits probability of the end date</skos:prefLabel>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/ProbabilityOfEndDate"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/ST_phe_TER_wildFruits_POED_Prod1"/>
  </rdf:Description>
