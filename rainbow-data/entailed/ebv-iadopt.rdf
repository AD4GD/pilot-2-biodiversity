  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/ES_edis_MA_ecosystemProductivity_NPP">
    <skos:definition>Productivity in an ecosystem refers to the percentage of energy that enters the ecosystem in the form of biomass at a particular trophic level. It is the rate at which biomass is formed in the ecosystem. Net primary production.</skos:definition>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/netPimaryProduction"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/marine"/>
    <skos:prefLabel>Primary productivity of marine ecosystem productivity net primary production</skos:prefLabel>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Primary_productivity"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/ES_edis_MA_ecosystemProductivity_NPP_Prod1"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <ns1:hasConstraint rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/algaeCyanobacteriaAndOtherMicroorganisms"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/ecosystemProductivity"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
  </rdf:Description>
