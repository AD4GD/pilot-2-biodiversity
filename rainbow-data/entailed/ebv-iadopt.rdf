  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/SP_dis_TER_invasiveAlienTaxa_BPA">
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/SP_dis_TER_invasiveAlienTaxa_BPA_Prod1"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <ns1:hasConstraint rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/specifiedInTheListOfInvasiveAlienSpecies"/>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/binaryPresenceAbsence"/>
    <skos:definition>The presence/absence of invasive terrestrial species within contiguous spatial units (grid cells) across the EU over time.</skos:definition>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <skos:prefLabel>Species distributions of terrestrial invasive alien taxa binary presence absence</skos:prefLabel>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/invasiveAlienTaxa"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Species_distributions"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/CC_com_TER_soilMicrobes_MOSBDS_Prod1">
