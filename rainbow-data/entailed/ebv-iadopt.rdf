  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/SP_abn_FW_dragonflies_EC">
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:prefLabel>Species distributions of freshwater dragonflies estimated count</skos:prefLabel>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/dragonflies"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/freshwater"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/SP_abn_FW_dragonflies_EC_Prod1"/>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/estimatedCount"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Species_distributions"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <skos:definition>The estimated abundance of European dragonly species within contiguous spatial units (grid cells) across the EU over time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/EF_ephe_TER_landSurfaceVegetation_LS">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:definition>The seasonal pattern of land surface vegetation variation observed from remote sensing within contiguous spatial units (grid cells) across the EU over time. Length of season.</skos:definition>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/lengthOfSeason"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Ecosystem_phenology"/>
    <skos:prefLabel>Ecosystem phenology of terrestrial land surface vegetation length of season</skos:prefLabel>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/EF_ephe_TER_landSurfaceVegetation_LS_Prod1"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/landSurfaceVegetation"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/EF_pro_TER_plantMaterial_TBI_Prod1">
    <skos:prefLabel>Primary productivity of terrestrial plant material Tea Bag Index product</skos:prefLabel>
