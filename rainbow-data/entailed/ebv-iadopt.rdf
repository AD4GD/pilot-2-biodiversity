    <ns4:collectionView rdf:resource="http://w3id.org/ad4gd/ev/ebv/"/>
    <skos:definition xml:lang="en">Essential Biodiversity Variables (EBVs) are defined as a minimum set of measurements, complementary to one another, that can capture major dimensions of biodiversity change. EBVs are organized in six classes (Genetic composition, Species populations, Species traits, Community composition, Ecosystem functioning, Ecosystem structure) and cover the three realms (Marine/coastal, Terrestrial and Freshwater)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://geobon.org/ebvs"/>
    <dcterms:identifier rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">EBV</dcterms:identifier>
    <dcterms:source rdf:resource="http://www.opengis.net/def/entities/bodies/ogcna"/>
    <dcterms:title xml:lang="en">Essential Biodiversity Variables - codelist scheme</dcterms:title>
    <skos:prefLabel xml:lang="en">Essential Biodiversity Variables - codelist scheme</skos:prefLabel>
    <dcterms:description xml:lang="en">Essential Biodiversity Variables (EBVs) are defined as a minimum set of measurements, complementary to one another, that can capture major dimensions of biodiversity change. EBVs are organized in six classes (Genetic composition, Species populations, Species traits, Community composition, Ecosystem functioning, Ecosystem structure) and cover the three realms (Marine/coastal, Terrestrial and Freshwater)</dcterms:description>
    <rdfs:seeAlso rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <dcat:theme rdf:resource="http://w3id.org/ad4gd/ev/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/EF_pro_FW_biomassProduction_BIO">
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <ns1:hasConstraint rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/ecosystemsAndTransitionalWaters"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/freshwater"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/EF_pro_FW_biomassProduction_BIO_Prod1"/>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/biomass"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <skos:prefLabel>Primary productivity of freshwater biomass production biomass</skos:prefLabel>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Primary_productivity"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:definition>Productivity in an ecosystem refers to the percentage of energy that enters the ecosystem in the form of biomass at a particular trophic level. It is the rate at which biomass is formed in EU freshwater ecosystems and transitional waters.</skos:definition>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/biomassProduction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/EF_pro_TER_mammal_BR_Prod1">
    <ns2:higherTemporalResolution>3years</ns2:higherTemporalResolution>
    <skos:prefLabel>Primary productivity of terrestrial mammal herbivory biomass removed product</skos:prefLabel>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <ns2:lowerSpatialResolution>10km2SpatialResolution</ns2:lowerSpatialResolution>
    <ns2:higherSpatialResolution>1km2SpatialResolution</ns2:higherSpatialResolution>
    <ns2:measures rdf:resource="http://w3id.org/ad4gd/ev/ebv/EF_pro_TER_mammal_BR"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/EF_pro_TER_mammal_BR"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="https://w3id.org/ad4gd/model/Product"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <ns2:lowerTemporalResolution>6years</ns2:lowerTemporalResolution>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/SP_dis_FW_macrophytes_BPA">
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/SP_dis_FW_macrophytes_BPA_Prod1"/>
    <skos:prefLabel>Species distributions of freshwater macrophytes binary presence absence</skos:prefLabel>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Species_distributions"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/macrophytes"/>
    <skos:definition>The presence/absence of European macrophyte species in ECRINS (European catchments and rivers network system) and estuarine-marine habitats (marshes, estuaries).</skos:definition>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/freshwater"/>
