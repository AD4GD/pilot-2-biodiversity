    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
    <skos:definition>The annual timing of seasonal emergence of butterflies within contiguous spatial units (grid cells) across the EU over time. Day of emergence.</skos:definition>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/ST_phe_TER_butterflies_DOE_Prod1"/>
