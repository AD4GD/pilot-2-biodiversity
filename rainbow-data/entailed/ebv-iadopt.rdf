  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/ES_edis_MA_seagrassHabitats_BPA">
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/binaryPresenceAbsence"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/seagrassHabitats"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <skos:definition>Presence/absence of seagrass habitats in EU's marine waters within contiguous spatial units (grid cells) over time.</skos:definition>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/ES_edis_MA_seagrassHabitats_BPA_Prod1"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Ecosystem_distribution"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/marine"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <skos:prefLabel>Ecosystem distribution of marine seagrass habitats binary presence absence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/EF_ephe_TER_landSurfaceVegetation_DEOS">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/EF_ephe_TER_landSurfaceVegetation_DEOS_Prod1"/>
    <skos:prefLabel>Ecosystem phenology of terrestrial land surface vegetation day of end-of-season</skos:prefLabel>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/landSurfaceVegetation"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Ecosystem_phenology"/>
    <skos:definition>The seasonal pattern of land surface vegetation variation observed from remote sensing within contiguous spatial units (grid cells) across the EU over time. Day of end-of-season.</skos:definition>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/dayOfEndOfSeason"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/ES_con_FW_riversAndLakes_CRLP_Prod2">
