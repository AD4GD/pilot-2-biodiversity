  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/ES_edis_MA_ecosystemProductivity_BIO">
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/ES_edis_MA_ecosystemProductivity_BIO_Prod1"/>
    <skos:prefLabel>Primary productivity of marine ecosystem productivity biomass</skos:prefLabel>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/biomass"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <ns1:hasConstraint rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/algaeCyanobacteriaAndOtherMicroorganisms"/>
    <skos:definition>Productivity in an ecosystem refers to the percentage of energy that enters the ecosystem in the form of biomass at a particular trophic level. It is the rate at which biomass is formed in the ecosystem. Biomass.</skos:definition>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/ecosystemProductivity"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Primary_productivity"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/marine"/>
  </rdf:Description>
