    <rdf:type rdf:resource="https://schema.org/SoftwareApplication"/>
    <rdfs:label>OGC-NA tools</rdfs:label>
    <rdfs:comment>ogc.na.update_vocabs version 0.5.29</rdfs:comment>
    <dcterms:hasVersion>0.5.29</dcterms:hasVersion>
  </rdf:Description>
