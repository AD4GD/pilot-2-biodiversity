    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/reptiles"/>
    <skos:definition>The probability of occurrence of all European freshwater reptile species within contiguous spatial units (grid cells) across the EU over time.</skos:definition>
    <skos:prefLabel>Species distributions of freshwater reptiles probability of occurrence</skos:prefLabel>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/freshwater"/>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/probabilityOfOccurrence"/>
  </rdf:Description>
