    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/birds"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Species_abundances"/>
    <skos:prefLabel>Species abundances of terrestrial birds modeled relative abundance</skos:prefLabel>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/modeledRelativeAbundance"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/SP_abn_TER_mammals_EC_keyOvergroundSites_Prod1">
    <rdf:type rdf:resource="https://w3id.org/ad4gd/model/Product"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns2:lowerSpatialResolution>10km2SpatialResolution</ns2:lowerSpatialResolution>
