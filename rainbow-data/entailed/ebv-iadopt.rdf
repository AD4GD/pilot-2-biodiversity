    <ns1:hasConstraint rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/europeanTerrestrialLandAreas"/>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/HANPPharv"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Ecosystem_disturbances"/>
    <skos:prefLabel>Ecosystem disturbances of terrestrial Human Appropriation of Net Primary Production HANPPharv</skos:prefLabel>
    <skos:definition>Human Appropriation of Net Primary Production (HANPP) is the proportion of terrestrial NPP consumed directly and indirectly through human land. HANPPharv is the quantity of carbon in biomass harvested or otherwise consumed by people, including crops, timber, harvested crop residues, forest slash, forages consumed by livestock, and biomass lost to human-induced fires.</skos:definition>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/humanAppropriation"/>
  </rdf:Description>
