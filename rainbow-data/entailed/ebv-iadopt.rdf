  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/EF_pro_TER_biomassProduction_NSP">
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Primary_productivity"/>
    <skos:prefLabel>Primary productivity of terrestrial biomass production net secondary production</skos:prefLabel>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/biomassProduction"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/EF_pro_TER_biomassProduction_NSP_Prod1"/>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/netSecondaryProduction"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <skos:definition>Productivity in an ecosystem refers to the percentage of energy that enters the ecosystem in the form of biomass at a particular trophic level. It is the rate at which biomass is formed in the ecosystem. Net secondary production.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/EF_disturb_TER_humanAppropriation_HANPPluc">
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Ecosystem_disturbances"/>
    <skos:narrower rdf:resource="http://w3id.org/ad4gd/ev/ebv/EF_disturb_TER_humanAppropriation_HANPPluc_Prod1"/>
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <ns1:hasProperty rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/HANPPluc"/>
    <skos:prefLabel>Ecosystem disturbances of terrestrial Human Appropriation of Net Primary Production HANPPluc</skos:prefLabel>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <ns1:hasConstraint rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/europeanTerrestrialLandAreas"/>
    <ns1:hasObjectOfInterest rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/humanAppropriation"/>
    <ns1:hasMatrix rdf:resource="http://w3id.org/ad4gd/ev/ebv/entity/terrestrial"/>
    <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
    <rdf:type rdf:resource="http://w3id.org/ad4gd/ev/EBV"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition>Human Appropriation of Net Primary Production (HANPP) is the proportion of terrestrial NPP consumed directly and indirectly through human land. HANPPluc is the change in NPP as a result of human-induced land use change.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/ad4gd/ev/ebv/SP_dis_FW_reptiles_PO">
    <ns4:status rdf:resource="http://www.opengis.net/def/status/valid"/>
    <skos:inScheme rdf:resource="http://w3id.org/ad4gd/ev/ebv"/>
    <skos:broader rdf:resource="http://w3id.org/ad4gd/ev/ebv/Species_distributions"/>
